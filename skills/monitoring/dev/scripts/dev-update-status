#!/usr/bin/env bash
# dev-update-status — update data/dev.json + push (live dashboard).
# Usage: dev-update-status --stage <stage> [--task "..."] [--note "..."]
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null | tr -d '\r')"
[ -n "$ROOT" ] || { echo "Error: not in git repo. cd ke repo dulu." >&2; exit 1; }
exec python "$ROOT/scripts/update_status.py" --agent dev "$@"
